      "item": [
        {
          "name": "PayPal webhook callback (provider use)",
          "request": {
            "auth": { "type": "noauth" }, "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"WH-REPLACE_ME\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource\": {}\n}" },
            "description": "PayPal normally calls this endpoint and supplies verification headers. A manual request is expected to fail signature verification.",
            "url": "{{baseUrl}}/paypal/webhook"
          }
        },
        {
          "name": "Get PayPal client configuration",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/paypal/config" }
