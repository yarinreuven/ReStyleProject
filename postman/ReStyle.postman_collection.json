    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "firstName", "value": "ReStyle", "type": "text" },
                { "key": "lastName", "value": "User", "type": "text" },
                { "key": "email", "value": "user@example.com", "type": "text" },
                { "key": "password", "value": "ChangeMe123!", "type": "text" },
                { "key": "confirmPassword", "value": "ChangeMe123!", "type": "text" },
                { "key": "language", "value": "en", "type": "text" },
                { "key": "gender", "value": "female", "type": "text" },
                { "key": "termsAccepted", "value": "true", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login and save access token",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const body = pm.response.json();",
                "if (body.token) pm.collectionVariables.set('accessToken', body.token);"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get current user",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Refresh access token",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const body = pm.response.json();",
                "if (body.token) pm.collectionVariables.set('accessToken', body.token);"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [], "url": "{{baseUrl}}/auth/logout" }
        },
        {
          "name": "Google authentication",
          "request": {
            "auth": { "type": "noauth" }, "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"credential\": \"REPLACE_WITH_GOOGLE_CREDENTIAL\",\n  \"intent\": \"login\"\n}" },
            "url": "{{baseUrl}}/auth/google"
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "auth": { "type": "noauth" }, "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}" },
            "url": "{{baseUrl}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "auth": { "type": "noauth" }, "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}" },
            "url": "{{baseUrl}}/auth/reset-password"
          }
        },
        {
          "name": "Update current user",
          "request": {
            "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"ReStyle\",\n  \"lastName\": \"User\",\n  \"gender\": \"female\"\n}" },
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Delete current user (destructive)",
          "request": {
            "method": "DELETE", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"confirmation\": \"DELETE\"\n}" },
            "description": "Permanently deletes the authenticated account and its related data. Run this request only with a disposable test account.",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"ChangeMe123!\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}" },
            "url": "{{baseUrl}}/auth/password"
          }
        },
        {
          "name": "Request email change",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"new-email@example.com\"\n}" },
            "url": "{{baseUrl}}/auth/email-change/request"
          }
        },
        {
          "name": "Confirm email change",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"123456\"\n}" },
            "url": "{{baseUrl}}/auth/email-change/confirm"
          }
        },
        {
          "name": "List blocked users",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/blocked-users" }
