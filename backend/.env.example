MONGO_URI=mongodb_connection_string
PORT=3001
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug
APP_TIME_ZONE=Asia/Jerusalem

# SMTP email delivery (example values for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
EMAIL_FROM=your_email@gmail.com
SUPPORT_EMAIL=support@example.com

# Google Identity Services (same Web OAuth client ID in backend and frontend)
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# AI services. Use a separate free-tier Google project for ReStyle Studio so
# its requests never consume the paid image-generation balance.
GEMINI_API_KEY=
GEMINI_RESTYLE_API_KEY=

# PayPal Sandbox checkout. Never put the client secret in frontend files.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id
